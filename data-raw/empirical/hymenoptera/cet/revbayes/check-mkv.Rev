################################################################################
# Hymenoptera CET pipeline: fixed-tree RevBayes oracle for check-mkv.R.
#
# Morphology log-likelihood of each partition of the comparator
# (../../revbayes/hymenoptera_fbd.Rev: unordered fnJC(K) and ordered
# fnOrderedRateMatrix(maxState = K), dnPhyloCTMC(type = "Standard")) on a CET
# start tree with a strict clock (branch length = rate x duration), at three
# rates, for
#   coding 1: coding = "variable", no rate variation among characters
#             (CET mkv = "pattern", nRateCat = 1)
#   coding 2: coding = "all", no rate variation (CET mkv = "none", nRateCat = 1)
#   coding 3: coding = "variable", Gamma(4) rates with alpha = 1.10 (about the
#             comparator's posterior mean): the comparator's character model
#             and CET's (mkv = "pattern", nRateCat = 4)
#   coding 4: as 3 with alpha = 0.35 (strong rate variation)
#   coding 5: coding = "all", Gamma(4) rates with alpha = 1.10
# and the discretised Gamma rates for alpha 1.10 and 0.35 (RATES lines).
# Run (RevBayes development build; see run-check-mkv.sh) from a directory
# holding data/ (written by ../../revbayes/prepare-data.R) and
# start_tree.nwk.  print() gives 7 significant digits, so each value is
# printed as floor(x) and x - floor(x).
################################################################################
source("data/partitions.Rev")
n_morph = morph_names.size()
for (i in 1:n_morph) {
  morpho[i] <- readDiscreteCharacterData("data/morph_" + morph_names[i] + ".nex")
  print("PART " + i + " " + morph_names[i])
}
tree <- readTrees("start_tree.nwk", treetype = "clock")[1]
print("ROOTAGE")
print(tree.rootAge())
rates <- v(0.0007, 0.002, 0.006)
alphas <- v(1.10, 0.35)
for (a in 1:alphas.size()) {
  gr <- fnDiscretizeGamma(alphas[a], alphas[a], 4)
  for (j in 1:4) {
    print("RATES " + a + " " + j)
    print(floor(gr[j]))
    print(gr[j] - floor(gr[j]))
  }
}
for (r in 1:rates.size()) {
  for (i in 1:n_morph) {
    if (morph_ordered[i]) {
      q <- fnOrderedRateMatrix(maxState = morph_k[i])
    } else {
      q <- fnJC(morph_k[i])
    }
    for (cd in 1:5) {
      if (cd == 1) {
        x ~ dnPhyloCTMC(tree = tree, Q = q, branchRates = rates[r], type = "Standard",
                        coding = "variable")
      }
      if (cd == 2) {
        x ~ dnPhyloCTMC(tree = tree, Q = q, branchRates = rates[r], type = "Standard",
                        coding = "all")
      }
      if (cd == 3) {
        x ~ dnPhyloCTMC(tree = tree, Q = q, branchRates = rates[r],
                        siteRates = fnDiscretizeGamma(alphas[1], alphas[1], 4), type = "Standard",
                        coding = "variable")
      }
      if (cd == 4) {
        x ~ dnPhyloCTMC(tree = tree, Q = q, branchRates = rates[r],
                        siteRates = fnDiscretizeGamma(alphas[2], alphas[2], 4), type = "Standard",
                        coding = "variable")
      }
      if (cd == 5) {
        x ~ dnPhyloCTMC(tree = tree, Q = q, branchRates = rates[r],
                        siteRates = fnDiscretizeGamma(alphas[1], alphas[1], 4), type = "Standard",
                        coding = "all")
      }
      x.clamp(morpho[i])
      lnp = x.lnProbability()
      print("RESULT " + r + " " + i + " " + cd)
      print(floor(lnp))
      print(lnp - floor(lnp))
    }
  }
}
q()
