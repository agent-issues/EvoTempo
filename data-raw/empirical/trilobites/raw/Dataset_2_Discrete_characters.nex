BEGIN NOTES;
	[Taxon comments]
	TEXT TAXON=14 TEXT='Additional codings from Pillola 1991';
	TEXT TAXON=16 TEXT='Thoracic articulation is fulcrate.';
	TEXT TAXON=19 TEXT='Thoracic articulation is nonfulcrate, see Jell (in Bengtson et al. 1990, fig. 185F) for E. shensiensis.';
	TEXT TAXON=27 TEXT='Coded from Paterson & Jago (2006, fig. 5)';
	TEXT TAXON=33 TEXT='Thoracic articulation is fulcrate, see Jell (in Bengtson et al. 1990, fig. 183F).';
	TEXT TAXON=36 TEXT='Thoracic articulation is nonfulcrate, see Jell (in Bengtson et al. 1990, fig. 181), and Kruse (1998, fig. 11O-P) for R. amadeana.';

	[Character comments]
	TEXT CHARACTER=1 TEXT='See Paterson & Edgecombe''s (2006) character 1 for discussion.';
	TEXT CHARACTER=2 TEXT='Taxa coded as state 0 for character 1 are coded as inapplicable for this character. State 2 represents an autapomorphy of Yunnanocephalus yunnanensis.';
	TEXT CHARACTER=3 TEXT='Taxa coded as states 1 or 2 (or inapplicable) for character 2 are coded as inapplicable for this character. The following states represent autapomorphies: 9 (Akoldinioidia shanjiangensis); 11 (Asioptychaspis subglobosa); 13 (Lisania paibiensis); 14 (Conocoryphe sulzeri); 15 (Tasmacephalus platypus).';
	TEXT CHARACTER=5 TEXT='This character is modified from Paterson & Edgecombe''s (2006) character 2.';
	TEXT CHARACTER=6 TEXT='Taxa coded as inapplicable possess a cranidial spine: character 24, state 1. This character is modified from Paterson & Edgecombe''s (2006) character 5.';
	TEXT CHARACTER=7 TEXT='This character is modified from Paterson & Edgecombe''s (2006) character 6.';
	TEXT CHARACTER=8 TEXT='Taxa coded as states 0, 1, 3 or 4 for character 7 are coded as inapplicable for this character. This character is modified from Paterson & Edgecombe''s (2006) character 7.';
	TEXT CHARACTER=9 TEXT='Taxa coded as states 0, 2, 3 or 4 for character 7 are coded as inapplicable for this character.';
	TEXT CHARACTER=10 TEXT='This character is modified from Paterson & Edgecombe''s (2006) character 8.';
	TEXT CHARACTER=11 TEXT='Taxa coded as states 0, 2 or 3 for character 10 are coded as inapplicable for this character. This character is modified from Paterson & Edgecombe''s (2006) character 9.';
	TEXT CHARACTER=12 TEXT='Taxa coded as states 0, 2 or 3 for character 10 are coded as inapplicable for this character. This character is modified from Paterson & Edgecombe''s (2006) character 10.';
	TEXT CHARACTER=13 TEXT='Taxa coded as states 0, 1 or 3 for character 10 are coded as inapplicable for this character.';
	TEXT CHARACTER=14 TEXT='This character is modified from Paterson & Edgecombe''s (2006) character 12.';
	TEXT CHARACTER=15 TEXT='Taxa coded as states 0, 2 or 3 for character 14 are coded as inapplicable for this character. This character is modified from Paterson & Edgecombe''s (2006) character 13.';
	TEXT CHARACTER=16 TEXT='Taxa coded as states 0, 2 or 3 for character 14 are coded as inapplicable for this character. This character is modified from Paterson & Edgecombe''s (2006) character 14.';
	TEXT CHARACTER=17 TEXT='Taxa coded as states 0, 1 or 3 for character 14 are coded as inapplicable for this character.';
	TEXT CHARACTER=18 TEXT='State 1 represents an autapomorphy of Sao hirsuta.';
	TEXT CHARACTER=22 TEXT='State 1 represents an autapomorphy of Nephrolenellus geniculatus.';
	TEXT CHARACTER=24 TEXT='Definition of the cranidial spine follows Jell (1975, p. 4). This character equates to Cotton and Fortey''s (2005) character 65.';
	TEXT CHARACTER=25 TEXT='State 1 represents an autapomorphy of Tasmacephalus platypus.';
	TEXT CHARACTER=26 TEXT='State 1 represents an autapomorphy of Pterocephalia norfordi.';
	TEXT CHARACTER=27 TEXT='State 1 represents an autapomorphy of Pagetia ocellata.';
	TEXT CHARACTER=28 TEXT='State 1 represents an autapomorphy of Serrodiscus speciosus.';
	TEXT CHARACTER=29 TEXT='This character relates to the structure described by Adrain (2011; footnote 33, p. 107) and illustrated by Whittington (1997, fig. 30.2a, b).';
	TEXT CHARACTER=30 TEXT='This equates to Paterson & Edgecombe''s (2006) character 3.';
	TEXT CHARACTER=31 TEXT='Taxa coded as state 0 for character 30 or state 1 for characters 33 or 35 are coded as inapplicable for this character. Presence of a plectrum (state 1) may also incorporate what is termed a ''median preglabellar ridge'' (Whittington & Kelly 1997). See Paterson & Edgecombe''s (2006) character 4 for additional discussion.';
	TEXT CHARACTER=32 TEXT='Taxa coded as state 0 for characters 30 or 31 (or inapplicable for the latter) are coded as inapplicable for this character.';
	TEXT CHARACTER=33 TEXT='Taxa coded as state 0 for character 30 or state 1 for characters 31 or 35 are coded as inapplicable for this character.';
	TEXT CHARACTER=34 TEXT='Taxa coded as state 0 for characters 30 or 33 (or inapplicable for the latter) are coded as inapplicable for this character. State 0 represents an autapomorphy of Penarosa netenta and state 1 represents an autapomorphy of Strenuaeva inflata.';
	TEXT CHARACTER=35 TEXT='Taxa coded as state 0 for character 30 or state 1 for characters 31 or 33 are coded as inapplicable for this character. State 1 represents an autapomorphy of Liostracina tangwangzhaiensis.';
	TEXT CHARACTER=36 TEXT='Taxa coded as state 0 for character 30 are coded as inapplicable for this character.';
	TEXT CHARACTER=37 TEXT='Taxa coded as state 0 for characters 30 or 36 (or inapplicable for the latter) are coded as inapplicable for this character.';
	TEXT CHARACTER=38 TEXT='State 1 represents an autapomorphy of Dinesus ida.';
	TEXT CHARACTER=40 TEXT='Taxa coded as state 1 for character 39 are coded as inapplicable for this character.';
	TEXT CHARACTER=41 TEXT='Taxa coded as state 1 for character 39 are coded as inapplicable for this character.';
	TEXT CHARACTER=42 TEXT='Taxa coded as state 1 for character 39 are coded as inapplicable for this character. This character is modified from Paterson & Edgecombe''s (2006) character 17.';
	TEXT CHARACTER=43 TEXT='Taxa coded as state 1 for character 39 or state 2 for character 42 are coded as inapplicable for this character. This character is a modified version of Cotton''s (2001) character 47.';
	TEXT CHARACTER=44 TEXT='Taxa coded as state 1 for character 39 are coded as inapplicable for this character. See Paterson & Edgecombe''s (2006) character 15 for discussion.';
	TEXT CHARACTER=45 TEXT='Taxa coded as state 1 for character 39 are coded as inapplicable for this character. State 4 represents an autapomorphy of Ajrikina hunanensis. This character is modified from Paterson & Edgecombe''s (2006) character 18.';
	TEXT CHARACTER=46 TEXT='See Paterson & Edgecombe''s (2006) character 16 for discussion.';
	TEXT CHARACTER=47 TEXT='Taxa coded as state 1 for character 39 are coded as inapplicable for this character. This character is modified from Paterson & Edgecombe''s (2006) character 19.';
	TEXT CHARACTER=49 TEXT='Taxa coded as state 0 for character 48 are coded as inapplicable for this character.';
	TEXT CHARACTER=50 TEXT='This equates to Paterson & Edgecombe''s (2006) character 23.';
	TEXT CHARACTER=51 TEXT='This equates to Paterson & Edgecombe''s (2006) character 21.';
	TEXT CHARACTER=52 TEXT='State 1 represents an autapomorphy of Ajrikina hunanensis.';
	TEXT CHARACTER=53 TEXT='Taxa coded as state 1 for character 39 are coded as inapplicable for this character.';
	TEXT CHARACTER=55 TEXT='Taxa coded as state 0 for character 54 are coded as inapplicable for this character.';
	TEXT CHARACTER=57 TEXT='Taxa without a frontal area or coded as state 1 for character 56 are coded as inapplicable for this character. State 1 represents an autapomorphy of Hungaia puelchana.';
	TEXT CHARACTER=58 TEXT='State 1 represents an autapomorphy of Eurekia rintintini.';
	TEXT CHARACTER=59 TEXT='State 1 represents an autapomorphy of Asioptychaspis subglobosa.';
	TEXT CHARACTER=60 TEXT='Taxa that lack librigenae or a rostral plate are coded as inapplicable. State 2 represents an autapomorphy of Norwoodia boninoi.';
	TEXT CHARACTER=61 TEXT='Taxa coded as states 0 or 3 or inapplicable for character 60 are coded as inapplicable for this character. This character is based on the modes of development of the ventral median suture proposed by Park & Choi (2010, fig. 9). State 1 represents an autapomorphy of Pterocephalia norfordi.';
	TEXT CHARACTER=62 TEXT='See Paterson & Edgecombe''s (2006) character 24 for discussion.';
	TEXT CHARACTER=63 TEXT='Taxa coded as state 0 for character 62 are coded as inapplicable for this character.';
	TEXT CHARACTER=66 TEXT='Taxa coded as state 0 for character 65 are coded as inapplicable for this character. State 2 represents an autapomorphy of Zacanthopsis palmeri.';
	TEXT CHARACTER=69 TEXT='This character is modified from Paterson & Edgecombe''s (2006) character 25.';
	TEXT CHARACTER=70 TEXT='Taxa coded as state 0 for character 69 are coded as inapplicable for this character.';
	TEXT CHARACTER=72 TEXT='Taxa coded as state 0 for character 71 are coded as inapplicable for this character. The following states represent autapomorphies: 0 (Hamatolenus vincenti); 3 (Burnetiella leechi); 5 (Palaeadotes hunanensis). This character is modified from Paterson & Edgecombe''s (2006) character 32.';
	TEXT CHARACTER=73 TEXT='Taxa coded as state 0 for character 71 are coded as inapplicable for this character.';
	TEXT CHARACTER=74 TEXT='State 1 represents an autapomorphy of Burnetiella leechi.';
	TEXT CHARACTER=75 TEXT='Taxa with less than six thoracic segments (i.e., eodiscoids and Akoldinioidia shanjiangensis) are coded as inapplicable. See Paterson & Edgecombe''s (2006) character 26 for discussion.';
	TEXT CHARACTER=76 TEXT='The following states represent autapomorphies: 1 (Norwoodia boninoi); 2+5 (Redlichia takooensis); 3 (Bolaspidella housensis); 4 (Eoredlichia intermediata); 6 (Montezumaspis parallela); 8 (Elliptocephala asaphoides).';
	TEXT CHARACTER=77 TEXT='Taxa with unknown thoracic morphology are coded as being fulcrate (state 1) if there is an articulating facet on the pygidium. See Paterson & Edgecombe''s (2006) character 27 for discussion.';
	TEXT CHARACTER=78 TEXT='See Paterson & Edgecombe''s (2006) character 29 for discussion.';
	TEXT CHARACTER=79 TEXT='Taxa coded as state 2 for character 78 are coded as inapplicable for this character. See Paterson & Edgecombe''s (2006) character 30 for discussion.';
	TEXT CHARACTER=80 TEXT='State 1 includes taxa that have a distinct pygidial border.';
	TEXT CHARACTER=82 TEXT='See Paterson & Edgecombe''s (2006) character 35 for discussion.';
	TEXT CHARACTER=84 TEXT='Taxa coded as state 0 for character 83 are coded as inapplicable for this character.';
	TEXT CHARACTER=85 TEXT='State 1 represents an autapomorphy of Notchpeakia taylori.';
	TEXT CHARACTER=86 TEXT='State 4 represents an autapomorphy of Lonchopygella megaspina. See Paterson & Edgecombe''s (2006) character 36 for discussion.';
	TEXT CHARACTER=87 TEXT='This equates to Paterson & Edgecombe''s (2006) character 37.';
	TEXT CHARACTER=88 TEXT='Taxa coded as state 0 for character 87 are coded as inapplicable for this character. The following states represent autapomorphies: 5 (Tricrepicephalus texanus); 6 (Yinites wanshougongensis); 7 (Dikelocephalus minnesotensis); 8 (Zhangshania typica). This character is modified from Paterson & Edgecombe''s (2006) character 38.';
	TEXT CHARACTER=89 TEXT='Taxa coded as state 0 for character 87 are coded as inapplicable for this character.';
	TEXT CHARACTER=90 TEXT='Taxa coded as state 0 for characters 87 or 89 are coded as inapplicable for this character. State 1 represents an autapomorphy of Tricrepicephalus texanus.';
